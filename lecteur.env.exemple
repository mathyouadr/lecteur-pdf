# Copier en /opt/lecteur/lecteur.env (chmod 600, propriétaire : l'utilisateur du service).
# Ne jamais versionner le fichier rempli.
LECTEUR_HTTPS=1
PYTHONUTF8=1

# VoiceStudio (livres audio IA). Sans clé : voix Google uniquement.
VOICESTUDIO_URL=http://192.168.1.45:3900
VOICESTUDIO_CLE=

# Wake-on-LAN du serveur IA
SRV02_MAC=8c:89:a5:c2:03:02

# Extinction automatique (jeton Proxmox limité à Sys.PowerMgmt sur ce nœud). Vide : jamais d'extinction.
PVE_URL=https://192.168.1.50:8006
PVE_NOEUD=srv-02
PVE_JETON=
PVE_CA=/opt/lecteur/pve-root-ca.pem
